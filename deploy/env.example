# /etc/details-gateway/env  (chmod 600, owner root) — install.sh creates it with generated secrets.
# Never commit real values.

DATABASE_URL=postgres://gateway:CHANGE_ME@127.0.0.1:5432/details_gateway

# 32+ random chars each (install.sh: openssl rand -hex 32)
SESSION_SECRET=
OTP_PEPPER=
# Shared with HR / mail / BLS so they can verify dg_ticket (JWT HS256)
TICKET_SECRET=
# Shared secret for the internal permissions endpoints (/_gw/catalog, /_gw/grants) — header X-Gw-Proxy-Key.
# Give the same value to HR / WMS / mail / BLS. Empty = those endpoints answer 503.
GATEWAY_PROXY_KEY=
# AES-256-GCM key for «المعلومات التقنية» credentials (infra_secrets): exactly 64 hex chars (openssl rand -hex 32).
# Losing or changing it makes stored secrets unreadable. Empty = secrets endpoints answer 503 (the rest of the page still works).
SECRETS_KEY=

BASE_URL=https://details-wms.cloud
COOKIE_DOMAIN=.details-wms.cloud
ROOT_DOMAIN=details-wms.cloud

# SMTP (OTP mail)
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@details-consults.sa
SMTP_PASS=

# OTP over WhatsApp (details-whatsapp on the apps VPS over WireGuard). Defaults shown; GATEWAY_PROXY_KEY above is the shared key.
# Channel is chosen in «إعدادات النظام ← الجلسات والأمان» (security.otp_channel: email | whatsapp | both); OTP_CHANNEL only sets the env default.
#WHATSAPP_OTP_URL=http://10.9.0.3/internal/otp/send
#WHATSAPP_OTP_HOST=whatsapp.details-wms.cloud
#WHATSAPP_OTP_TIMEOUT_MS=8000
#OTP_CHANNEL=email

# Google sign-in (leave empty to hide the button)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://details-wms.cloud/api/auth/google/callback

# First admin, created only when the employees table is empty
BOOTSTRAP_ADMIN_EMPLOYEE_NO=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_EMAIL=
